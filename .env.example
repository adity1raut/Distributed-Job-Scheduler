# ---------------------------------------------------------------------------
# Single source of configuration for the Docker Compose stack.
#
#   cp .env.example .env
#
# Compose reads this file automatically. Every value has a working default
# for local development; the ones marked REQUIRED IN PRODUCTION must be
# replaced before this is exposed to anything but your laptop.
# ---------------------------------------------------------------------------

# Image coordinates. Compose builds locally by default; docker-compose.prod.yml
# pulls these tags from the registry instead.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=adity1raut/distributed-job-scheduler
IMAGE_TAG=latest

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=postgres
# REQUIRED IN PRODUCTION: generate with `openssl rand -base64 24`
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobscheduler
# Host port only (the container always listens on 5432). Deliberately not
# 5432, so the stack coexists with a Postgres already installed on the host.
POSTGRES_PORT=5433

# --- Redis -----------------------------------------------------------------
# REQUIRED IN PRODUCTION: leave empty only on a network where nothing else can
# reach Redis. Redis has no user model — this password is the whole boundary.
REDIS_PASSWORD=
# Host port only; see the note on POSTGRES_PORT.
REDIS_PORT=6380

# --- API -------------------------------------------------------------------
API_PORT=8080
APP_ENV=production

# REQUIRED IN PRODUCTION: generate with `openssl rand -base64 48`.
# Every issued token is signed with this; changing it logs everyone out.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRY_HOURS=24

RATE_LIMIT_PER_MIN=120
SHUTDOWN_TIMEOUT_SEC=15

# Requests reach the API through the nginx container, so without this every
# unauthenticated request would look like it came from that one proxy IP and
# would share a single rate-limit bucket. This is the default Docker bridge
# range; narrow it if you know your network layout.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# The dashboard calls the API same-origin through the nginx proxy, so CORS is
# not exercised by the compose stack at all. It still matters for anyone
# pointing a separately hosted frontend or a local `npm run dev` at this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Scheduler -------------------------------------------------------------
SCHEDULER_TICK_SEC=5
STALE_JOB_SEC=60

# --- Worker ----------------------------------------------------------------
# A worker belongs to exactly one organization and only claims that org's
# jobs. Leave this empty and the `bootstrap` service registers the demo org
# below and hands the ID to the worker automatically, so `docker compose up`
# works end to end. Set it explicitly to point workers at a real org.
WORKER_ORG_ID=
WORKER_REPLICAS=2
WORKER_CONCURRENCY=10
WORKER_POLL_MS=500
HEARTBEAT_SEC=10

# --- Bootstrap org (development convenience) -------------------------------
# Used only by the `bootstrap` service to create a first org so the worker has
# something to poll. Remove the bootstrap service in production and register
# through the UI instead.
BOOTSTRAP_ORG_NAME=Demo Org
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=password123

# --- Web / dashboard -------------------------------------------------------
WEB_PORT=3000
# Empty means "same origin": nginx proxies /api to the API container, so the
# browser makes no cross-origin request. Set this only if the API is served
# from a different hostname than the dashboard.
API_URL=

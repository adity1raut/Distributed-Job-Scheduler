# Copy to .env and adjust as needed. Every value below has the same default
# baked into internal/config.go, so .env is only needed to override one —
# except WORKER_ORG_ID, which has no default and cmd/worker refuses to start
# without it.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobscheduler?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24
API_PORT=8080

# Free-form label recorded on the startup log line, so you can tell which
# environment a log stream came from.
APP_ENV=development

# How long the API waits for in-flight requests to finish on SIGTERM before
# forcing the shutdown.
SHUTDOWN_TIMEOUT_SEC=15

# Required by cmd/worker only. A worker now belongs to exactly one
# organization and only claims that org's jobs — copy the "org_id" from
# your register/login response (or decode it from the JWT) and set it here
# before starting a worker.
WORKER_ORG_ID=

WORKER_POLL_MS=500
WORKER_CONCURRENCY=10
HEARTBEAT_SEC=10
STALE_JOB_SEC=60

SCHEDULER_TICK_SEC=5
RATE_LIMIT_PER_MIN=120
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated CIDRs (or bare IPs) of reverse proxies allowed to set
# X-Forwarded-For. Unauthenticated requests are rate limited per client IP, so
# behind a proxy without this every login attempt shares one bucket. The header
# is forgeable, so it is honoured only from these addresses — leave empty when
# the API is reached directly.
TRUSTED_PROXIES=

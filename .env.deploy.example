# Copy to .env before running `docker compose up` — see DEPLOYMENT.md.
# Every value has a default baked into docker-compose.yml except JWT_SECRET,
# which docker-compose will refuse to start api without.

# REQUIRED — generate with: openssl rand -base64 48
JWT_SECRET=

# Origin(s) the frontend is actually served from, comma-separated.
# The compose default (localhost:5173) only works for local use.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public URL the *browser* will call — baked into the frontend at container
# startup (see docker-entrypoint.d/40-render-config.sh), not build time.
VITE_API_URL=http://localhost:8080

# Only needed once you run: docker compose --profile worker up -d worker
# (after registering an org through the frontend and copying its org_id).
WORKER_ORG_ID=

# Optional overrides — defaults match internal/config.go.
# JWT_EXPIRY_HOURS=24
# RATE_LIMIT_PER_MIN=120
# SCHEDULER_TICK_SEC=5
# STALE_JOB_SEC=60
# WORKER_POLL_MS=500
# WORKER_CONCURRENCY=10
# HEARTBEAT_SEC=10
